---
import Header from '../components/Header.astro';
import '../styles/global.css';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Autonomy Lab</title>
  </head>
  <body>
    <div class="site">
      <Header />
      <slot />
    </div>
  </body>
</html>
